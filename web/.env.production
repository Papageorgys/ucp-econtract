# Non-secret per-environment config, committed on purpose.
#
# This is the public Supabase project URL — the same string that appears in any browser
# request to the project. It is not a credential and nothing is protected by keeping it
# out of the repo. Keeping it here means a deploy works without hand-configuration.
#
# A Vercel environment variable of the same name overrides this file, so set one there
# to point a deployment at a different Supabase project.
#
# Secrets do NOT belong here. PROTO_AGENT_TOKEN, AGENT_CONSOLE_PASSWORD and
# AGENT_SESSION_SECRET are set in the Vercel project settings only. See .env.example.

SUPABASE_FUNCTIONS_URL=https://mwxfmkuedrlsbtssryxk.supabase.co/functions/v1
