# Vercel project environment. None of these are NEXT_PUBLIC_* — nothing here reaches the browser.
#
# Only SUPABASE_FUNCTIONS_URL is needed for the customer journey. The other three gate the
# agent console alone; without them the customer side still works end to end.

# Base URL of the Supabase Edge Functions, no trailing slash. NOT a secret — it is the public
# project URL. A default for this deployment is committed in .env.production; set a Vercel
# environment variable of the same name to override it (Vercel env wins over .env files).
SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1

# ── Agent console only. Secrets: set these in the Vercel project settings, never in a file. ──

# Must be byte-identical to the Supabase function secret of the same name, or the upstream
# rejects every agent request no matter what this is set to. Attached server-side by the proxy
# on agent-scoped calls only; never exposed to the client.
#   supabase secrets set PROTO_AGENT_TOKEN=<value>
PROTO_AGENT_TOKEN=

# Gate for /agent. One shared password, prototype-grade — see README "Known limits".
AGENT_CONSOLE_PASSWORD=

# HMAC key for the agent session cookie. Must be independent of PROTO_AGENT_TOKEN so the
# upstream token is not derivable from anything that reaches a browser.
#   openssl rand -base64 32
AGENT_SESSION_SECRET=
