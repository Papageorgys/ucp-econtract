# Vercel project environment. None of these are NEXT_PUBLIC_* — nothing here reaches the browser.

# Base URL of the Supabase Edge Functions, no trailing slash.
SUPABASE_FUNCTIONS_URL=https://<project-ref>.supabase.co/functions/v1

# Same value as the Supabase secret of the same name. Attached server-side by the proxy route
# on agent-scoped requests only. Never expose this to the client.
PROTO_AGENT_TOKEN=

# Gate for the agent console. Shared password, prototype-grade — see web/README.md.
AGENT_CONSOLE_PASSWORD=

# HMAC key for the agent session cookie. Must be independent of PROTO_AGENT_TOKEN.
# Generate with: openssl rand -base64 32
AGENT_SESSION_SECRET=
