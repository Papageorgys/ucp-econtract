# Set with: supabase secrets set KEY=value
PROTO_AGENT_TOKEN=change-me            # bearer for agent endpoints in the prototype
ANTHROPIC_API_KEY=                     # vision extraction via Claude (preferred if set)
GEMINI_API_KEY=                        # vision extraction via Gemini (used if ANTHROPIC_API_KEY unset)
EXTRACT_MODEL=                         # optional override, e.g. claude-sonnet-4-6 or gemini-2.5-pro
BRAND_NAME=Utility
SUPPLIER_LEGAL=The Supplier
SUPPORT_PHONE=
EID_NAME=e-ID Wallet
GRID_OPERATOR=the grid operator
TAX_ID_LABEL=Tax ID
DEFAULT_LOCALE=el
SMS_WEBHOOK_URL=                       # optional: POST {to, text}; when unset OTP codes are logged, not sent
